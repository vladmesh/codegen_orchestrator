# syntax=docker/dockerfile:1.4
FROM python:3.12.13-slim AS test

WORKDIR /app

# Install uv for fast package management
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /bin/uv

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy shared packages
COPY shared /app/shared

# Copy worker wrapper package
COPY packages/worker-wrapper /app/packages/worker-wrapper

# Install dependencies
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system \
    pytest \
    pytest-asyncio \
    respx \
    "fakeredis>=2.34.1" \
    structlog \
    -e /app/packages/worker-wrapper

# Set Python path
ENV PYTHONPATH=/app/packages/worker-wrapper/src:/app

# Default command
CMD ["pytest", "/app/tests/integration/worker_wrapper", "-v"]

# Which tree this image baked shared from; read by scripts/shared_freshness.py.
ARG SOURCE_HASH=unknown
LABEL org.codegen.worker_source_hash=$SOURCE_HASH
