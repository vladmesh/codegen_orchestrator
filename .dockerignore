# Git
.git/
.github/
.gitignore

# Python (** matches nested dirs like services/api/src/__pycache__/)
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.ruff_cache/
# A mock's os.fspath() name, left by a unit test that used a MagicMock as a path
MagicMock/
**/MagicMock/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation (not needed in production images)
*.md
docs/
!README.md

# Test files (not needed in production images)
tests/
# */tests/
# Except allow these for test Docker builds
!shared/tests/
!shared/cli/tests/
!services/*/tests/
!packages/*/tests/
!tests/

# Environment
.env
.env.*
!.env.example

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
.cache/

# Virtual environments (** matches nested dirs like shared/.venv/)
**/.venv/
**/venv/

# Gemini artifacts (local development)
.gemini/

# Node dependencies (frontend services install their own in the image)
**/node_modules/

# Local runtime state: board state and live harness ownership records
state/
.live-manifests/

# uv
uv.lock
**/uv.lock

# The runner proof job checks the kit and platform out here (.github/workflows/ci.yml).
.runner/
