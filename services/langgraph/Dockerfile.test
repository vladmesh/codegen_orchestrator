# syntax=docker/dockerfile:1.4
# Multi-stage Dockerfile optimized for testing with caching

FROM python:3.12.13-slim AS base

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# === Test Dependencies Stage ===
FROM base AS test-deps

# Copy only dependency files first (for caching)
COPY services/langgraph/pyproject.toml ./

# Install runtime + test dependencies
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install . && \
    pip install pytest pytest-asyncio pytest-cov

# === Test Stage ===
FROM test-deps AS test

# Copy shared as plain files (deps are in the service pyproject.toml)
COPY shared /app/shared
ENV PYTHONPATH=/app

# Copy source code
COPY services/langgraph/src ./src
COPY services/langgraph/tests ./tests
COPY services/langgraph/pytest.ini ./

# Run tests
CMD ["pytest", "-v"]

# Which tree this image baked shared from; read by scripts/shared_freshness.py.
ARG SOURCE_HASH=unknown
LABEL org.codegen.worker_source_hash=$SOURCE_HASH
