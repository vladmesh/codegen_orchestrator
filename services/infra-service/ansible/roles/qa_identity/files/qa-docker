#!/bin/sh
# The target's own answer to "what may the QA account do with docker?".
#
# The QA account is not in the `docker` group and cannot reach the socket, on
# purpose: membership of that group is root on this host, so an account that has
# it is not an unprivileged one. It reaches docker through this command only,
# and sudo lets it run this command only.
#
# The allowlist is here rather than in sudoers because this is the question
# sudoers cannot answer. General `docker exec` and `docker run` mount and write;
# `docker cp` writes into a container; `docker build`, `commit` and `save` create host
# state. A sudoers wildcard over `docker *` would allow every one of them, and a
# per-sub-command sudoers wildcard matches arguments as one concatenated string,
# which is not a boundary anybody can read. So the boundary is a list of names,
# checked before docker is reached at all. `read-contract` is not an admitted
# Docker sub-command: it expands here into one fixed, contained read of three
# non-secret paths, with no caller-controlled program or arguments.
#
# What this does NOT decide is which containers a run may look at. That is the
# run's capability set, resolved in the orchestrator from deployment data, and
# it is what keeps one project's run out of another project's containers. This
# script answers only the host's own question: this account never gets a write,
# whatever the orchestrator sends.
#
# `docker` is resolved through PATH deliberately: sudo replaces the caller's
# environment with `secure_path`, whose directories are root-owned, so the
# lookup cannot be steered by the QA account.

set -eu

ALLOWED="diff inspect logs port ps read-contract stats top"

if [ "$#" -eq 0 ]; then
    echo "qa-docker: a docker sub-command is required; allowed: $ALLOWED" >&2
    exit 2
fi

subcommand=$1

if [ "$subcommand" = "read-contract" ]; then
    if [ "$#" -ne 4 ]; then
        echo "qa-docker: read-contract requires container, contract path and fixed limit" >&2
        exit 2
    fi
    container=$2
    path=$3
    limit=$4
    case "$path" in
        codegen_kit/_active_packages.py|services/backend/manifest.yaml|services/backend/src/generated/jobs_schemas.py) ;;
        *) echo "qa-docker: refused generated contract path" >&2; exit 2 ;;
    esac
    if [ "$limit" != "262144" ]; then
        echo "qa-docker: refused generated contract byte limit" >&2
        exit 2
    fi
    exec docker exec "$container" sh -c '
set -eu
root=$(readlink -f -- /app) || {
    echo "container /app does not resolve" >&2
    exit 4
}
requested=$1
limit=$2
candidate=$root/$requested
if [ ! -e "$candidate" ] && [ ! -L "$candidate" ]; then
    exit 5
fi
resolved=$(readlink -f -- "$candidate") || {
    echo "contract path does not resolve" >&2
    exit 4
}
case "$resolved" in
    "$root"/*) ;;
    *) echo "contract path resolves outside /app" >&2; exit 4 ;;
esac
[ -e "$resolved" ] || exit 5
[ -f "$resolved" ] && [ -r "$resolved" ] || {
    echo "contract is not a readable regular file" >&2
    exit 7
}
size=$(wc -c < "$resolved") || {
    echo "contract size could not be read" >&2
    exit 7
}
[ "$size" -le "$limit" ] || {
    echo "contract exceeds the read limit" >&2
    exit 6
}
cat -- "$resolved" || {
    echo "contract read failed" >&2
    exit 7
}
' _ "$path" "$limit"
fi

for allowed in $ALLOWED; do
    [ "$allowed" = "read-contract" ] && continue
    if [ "$subcommand" = "$allowed" ]; then
        exec docker "$@"
    fi
done

echo "qa-docker: docker $subcommand is refused on this host; allowed: $ALLOWED" >&2
exit 2
