# syntax=docker/dockerfile:1.4
FROM python:3.12.13-slim

WORKDIR /app

# Install dependencies from lock file + test deps first (change rarely)
COPY services/telegram_bot/requirements.lock ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.lock && \
    pip install pytest pytest-asyncio pytest-cov httpx respx

# Copy shared as plain files (deps come from requirements.lock)
COPY shared /app/shared
ENV PYTHONPATH=/app

# Copy source
COPY services/telegram_bot/src ./src
COPY services/telegram_bot/tests ./tests

CMD ["pytest", "-v"]

# Which tree this image baked shared from; read by scripts/shared_freshness.py.
ARG SOURCE_HASH=unknown
LABEL org.codegen.worker_source_hash=$SOURCE_HASH
