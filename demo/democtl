#!/bin/sh
# Scene control for the Brimos dashboard demo.
#   ./democtl go [at]              ONE command at the Confirm moment: reset + start at 1x (at = offset, s)
#   ./democtl start [speed] [at]   start scene 1 (speed 1 = real 10 min; at = start offset, s)
#   ./democtl reset                back to idle (only old products visible) — before every take
#   ./democtl seek <at>            jump to a scene second (catch up with the bot)
#   ./democtl state                running / scene second / bot stage
B=${DEMO_URL:-http://127.0.0.1:8790}
case "$1" in
  go)    curl -sf -XPOST "$B/demo/reset" >/dev/null || { echo "demo API is down: $B" >&2; exit 1; }
         curl -s -XPOST "$B/demo/start?speed=1&at=${2:-0}" ;;
  start) curl -s -XPOST "$B/demo/start?speed=${2:-1}&at=${3:-0}" ;;
  reset) curl -s -XPOST "$B/demo/reset" ;;
  seek)  curl -s -XPOST "$B/demo/seek?at=${2:?at}" ;;
  state|"") curl -s "$B/demo/state" ;;
  *) echo "usage: $0 go [at] | start [speed] [at] | reset | seek <at> | state" >&2; exit 2 ;;
esac
echo
