#!/bin/sh
# Scene control for the Brimos dashboard demo.
#   ./democtl reset [scene]          back to idle (only old products visible); scene 1 or 2 switches the scene
#                                   (kept until switched again) — before every take
#   ./democtl go [at]                ONE command at the Confirm moment: reset + start at 1x (at = offset, s)
#   ./democtl start [speed] [at]     start the current scene (speed 1 = real time; at = start offset, s)
#   ./democtl seek <at>              jump to a scene second (catch up with the bot)
#   ./democtl state                  scene / running / scene second / bot stage
# Scene 1 "builds from scratch" (Water Reminder Bot, 10 min), scene 2 "reuses the platform"
# (Competitor Digest, 4 min). `go` and `start` play whichever scene the last `reset N` chose.
B=${DEMO_URL:-http://127.0.0.1:8790}
case "$1" in
  go)    curl -sf -XPOST "$B/demo/reset" >/dev/null || { echo "demo API is down: $B" >&2; exit 1; }
         curl -s -XPOST "$B/demo/start?speed=1&at=${2:-0}" ;;
  start) curl -s -XPOST "$B/demo/start?speed=${2:-1}&at=${3:-0}" ;;
  reset) if [ -n "$2" ]; then curl -s -XPOST "$B/demo/reset?scene=$2"; else curl -s -XPOST "$B/demo/reset"; fi ;;
  seek)  curl -s -XPOST "$B/demo/seek?at=${2:?at}" ;;
  state|"") curl -s "$B/demo/state" ;;
  *) echo "usage: $0 reset [1|2] | go [at] | start [speed] [at] | seek <at> | state" >&2; exit 2 ;;
esac
echo
