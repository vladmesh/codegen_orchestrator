{
    log {
        format json
    }

    # A client that connects to a bare IP sends no SNI, because SNI cannot carry
    # an IP literal, and Caddy then has no server name to select a certificate by
    # and aborts with an internal-error alert. The stand reaches its registry by
    # name, so this is insurance rather than the main path — but it turns an
    # opaque handshake failure into an ordinary verification error, which is the
    # difference between a diagnosable run and a lost afternoon.
    default_sni {$ORCHESTRATOR_HOSTNAME}
}

{$ORCHESTRATOR_HOSTNAME} {
    handle /v2/* {
        basic_auth {
            {$REGISTRY_USER} {$REGISTRY_PASSWORD_HASH}
        }
        reverse_proxy registry:5000
    }

    handle /loki/* {
        basic_auth {
            {$LOKI_PUSH_USER} {$LOKI_PUSH_PASSWORD_HASH}
        }
        uri strip_prefix /loki
        reverse_proxy loki:3100
    }

    handle /lk/* {
        uri strip_prefix /lk
        reverse_proxy user-dashboard:80
    }

    handle /lk {
        redir /lk/ permanent
    }

}
