[Unit]
Description=Orchestrator PostgreSQL daily backup
# Install ONLY in the owning user's manager, beside its rootless docker.service.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/backup-db-rootless.sh backup
EnvironmentFile=%h/.config/codegen-orchestrator/backup.env
UMask=0077
