[Unit]
Description=Orchestrator PostgreSQL daily backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/orchestrator-backup-db.sh
EnvironmentFile=/etc/codegen-orchestrator-backup.env
WorkingDirectory=/opt/codegen_orchestrator
UMask=0077
User=deploy
Group=deploy

[Install]
WantedBy=multi-user.target
