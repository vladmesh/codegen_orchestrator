# Recorded h01o configuration. PO confirms it is still current before installation.
# Install as vlad in ~/.config/codegen-orchestrator/backup.env, mode 0600.
# Both systemd EnvironmentFile and the owning shell load this non-secret policy.
BACKUP_USER=vlad
BACKUP_UID=1001
BACKUP_RUNTIME_DIR=/run/user/1001
COMPOSE_DIR=/home/vlad/codegen_orchestrator
COMPOSE_ARGS="-p codegen_orchestrator -f docker-compose.yml -f docker-compose.prod.yml -f /home/vlad/codegen-h01o.override.yml -f deployed-service-images.compose.yml"
BACKUP_DIR=/home/vlad/backups/orchestrator/nightly
BACKUP_KIND=nightly
BACKUP_CONTOUR=production
BACKUP_RETAIN=7
