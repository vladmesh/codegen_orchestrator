# Install as /etc/codegen-orchestrator-backup.env, root:deploy, mode 0640.
# Include the actual host-specific Compose override, if configured, before the
# current digest override. No credentials: the running db container supplies them.
COMPOSE_DIR=/opt/codegen_orchestrator
COMPOSE_ARGS="-f docker-compose.yml -f docker-compose.prod.yml -f deployed-service-images.compose.yml"
BACKUP_DIR=/opt/backups/orchestrator/nightly
BACKUP_KIND=nightly
BACKUP_CONTOUR=production
BACKUP_RETAIN=7
