# env_fixture Environment Configuration
# Copy this file to .env and adjust values as needed

# Set a unique Compose project name when running multiple generated projects
# on the same Docker host.
# COMPOSE_PROJECT_NAME=env_fixture-dev

# Application
APP_NAME=env_fixture
APP_ENV=development
APP_SECRET_KEY=please-change-me-in-production
# Local-only fixture for POST /users/grant. Deployment replaces this through
# the typed generated-secret resolver.
USERS_GRANT_CAPABILITY=local-grant-capability-not-for-production
# Local-only fixture for POST /settings/set. Deployment replaces this through
# the typed generated-secret resolver.
SETTINGS_WRITE_CAPABILITY=local-settings-capability-not-for-production
# Local-only fixture for POST /jobs/fire. Deployment replaces this through
# the typed generated-secret resolver.
JOBS_FIRE_CAPABILITY=local-jobs-capability-not-for-production
DEBUG=true

# Backend host port (mapped to container's 8000)
BACKEND_PORT=8000

# Database (PostgreSQL)
POSTGRES_HOST_PORT=5432
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=env_fixture
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_REQUIRE_SSL=false

# Redis (for async messaging)
REDIS_HOST_PORT=6379
REDIS_URL=redis://redis:6379

# Backend API URL (for service-to-service communication)
BACKEND_API_URL=http://backend:8000

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Docker images (for production compose)
BACKEND_IMAGE=env_fixture-backend:latest
TG_BOT_IMAGE=env_fixture-tg:latest
NOTIFICATIONS_WORKER_IMAGE=env_fixture-notifications:latest
FRONTEND_IMAGE=env_fixture-frontend:latest
FRONTEND_PORT=4321
